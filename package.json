{
  "name": "event-pass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @eventpass/api",
    "dev:web": "npm run dev -w @eventpass/web",
    "build": "npm run build -w @eventpass/api && npm run build -w @eventpass/web",
    "test": "npm run test -w @eventpass/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
